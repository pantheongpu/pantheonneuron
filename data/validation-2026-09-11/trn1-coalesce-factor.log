# trn1.2xlarge (us-east-1), 2026-09-11 UTC. tensor_virus's coalesced tiling: how many
# accumulators, and how wide the moving tile? coalesce_sweep.sh: each variant a copy of the
# tree with COALESCE_ROWS and MOVING patched (the bracket shows the patched lines), its own
# compile cache, run() for 20 s at 8192^3 bf16, every row-tile of the product checked
# (ROW_CHECK_PERIOD 7 at the time -- see the note at the end).
# PREDICTED: if lhs load width still limits, 8 > 4 > 2; a full PSUM (B) might stall instead.

A [MOVING = 512                        # N per matmul call COALESCE_ROWS = 4 ]  71.72 TFLOPS  row-tiles wrong 0/64  warning None
B [MOVING = 512                        # N per matmul call COALESCE_ROWS = 8 ]  78.15 TFLOPS  row-tiles wrong 0/64  warning None
C [MOVING = 512                        # N per matmul call COALESCE_ROWS = 2 ]  51.80 TFLOPS  row-tiles wrong 0/64  warning None
D [MOVING = 256                        # N per matmul call COALESCE_ROWS = 8 ]  61.86 TFLOPS  row-tiles wrong 0/64  warning None
E [MOVING = 128                        # N per matmul call COALESCE_ROWS = 16 ]  30.73 TFLOPS  row-tiles wrong 0/64  warning None

## Harness at COALESCE_ROWS = 8, ROW_CHECK_PERIOD = 13
COALESCE_ROWS = 8
ROW_CHECK_PERIOD = 13
